class Even_Odd_OfArray 
{
	public static void main(String[] args) 
	{
		int arr[] = {10,11,12,13,14,27};
		System.out.print("Even number : ");
		for(int i =0; i<arr.length; i++)
		{
			if(arr[i] %2 ==0)
				System.out.print( arr[i]+ " ");
		}
		System.out.println("");
		System.out.print("Odd number : ");
		for(int i =0; i<arr.length; i++)
		{
			if(arr[i] %2 !=0)
				System.out.print(arr[i]+ " ");
		}
	}
}
