import java.util.*;
class IsPrime
{
	static Scanner sc= new Scanner(System.in);
	public static void main(String[] args) 
	{
		System.out.print("Enter the number:");
		int n = sc.nextInt();
		int count =0;
		for(int i =1; i<=n; i++)
		{
			 if(n % i ==0)
				 count++;
		}
		if(count==2)
			System.out.print("it is a prime number");
		else
			System.out.print("not a primr number");
	}
}
