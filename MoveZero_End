import java.util.*;
class MoveZero_End
{
    public static void main(String[] args)
    {
        int arr[] = {5, 1, 6, 0, 0, 3, 9, 0, 6, 7, 8, 12, 10, 0, 2};
        int index = 0;
        for(int i = 0; i < arr.length; i++)
        {
            if(arr[i] != 0)
            {
                arr[index] = arr[i];
                index++;
            }
        }
        while(index < arr.length)
        {
            arr[index] = 0;
            index++;
        }
        System.out.println(Arrays.toString(arr));
    }
}
