import java.util.Scanner;
class Nive 
{
	static Scanner sc = new Scanner(System.in);
	public static void main(String[] args) 
	{
		final int aFinal;
		aFinal=10;
		System.out.println("Enter the number : ");
		int n = sc.nextInt();
		
		int og = n;
		
		int sum = 0;
		while(n>0)
		{
			int lastdigit = n % 10;
			sum = sum + lastdigit;
			n = n/10;
		}
		
		System.out.println("sum is :"+sum);
		System.out.println("og is :"+og);
		
		if (og % sum ==0)
		{
			System.out.println("it is Nive");
		}
		else{
			System.out.println("it is not Nive");
		}
			
	}
}
