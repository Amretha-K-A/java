import java.util.*;
class Palandrome 
{
	static Scanner sc = new Scanner(System.in);
	public static void main(String[] args) 
	{
		System.out.print("Enter number:");
		int n = sc.nextInt();
		int og = n;
		int rev = 0;
		while(n >0)
		{
			int ld = n % 10;
			rev = rev * 10 + ld;
			n = n /10;
		}
		System.out.println(rev);
		if(og ==rev)
			System.out.println("it ia palandrome number");
		else
			System.out.println("it is not an palandrome number");
	}
}
