class Person
{
	String name;
	int age;
	
	void displayPerson()
	{
		System.out.println("Name :"+name);
		System.out.println("Age :"+age);
	}
}
class Student extends Person
{
	int rollno;
	int mark;
	
	void displayStudent()
	{
		System.out.println("rollno :"+rollno);
		System.out.println("mark :"+mark);
	}
}
class StudentMain  
{
	public static void main(String[] args) 
	{
		Student s1 = new Student();
		s1.name = "Thara";
		s1.age = 21;
		s1.rollno = 34;
		s1.mark = 413;
		s1.displayPerson();
		s1.displayStudent();
	}
}
