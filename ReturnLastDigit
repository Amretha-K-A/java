import java.util.*;
class  ReturnLastDigit
{
	static Scanner sc = new Scanner(System.in);
	public static void main(String[] args) 
	{
		System.out.print("Enter the number ");
		int num = sc.nextInt();
		
		int ld = num % 10;
		
		System.out.println("Last diigit of the given number is : "+ ld);
	}
}
