import java.util.*;
class ExactMultiple 
{
	static Scanner sc = new Scanner(System.in);
	public static void main(String[] args) 
	{
		System.out.print("Enter the number:");
		int num = sc.nextInt();
		System.out.print("Enter the mul:");
		int numm = sc.nextInt();
		
		if(num % numm ==0)
			System.out.println("it is exact multiple");
		else
			System.out.println("it is not a exact multiple");
	}
}
