class Employe
{
	private int id;
	private String name;
	private double salary;
	Employe(){}
	Employe(int id, String name, double salary)
	{
		this.id = id;
		this.name = name;
		this.salary = salary;
	}
	public int getId()
	{
		return id;
	}
	public void setId(int id)
	{
		this.id = id;
	}
	public String getName()
	{
		return name;
	}
	public void setName(String name)
	{
		this.name = name;
	}
	public double getSalary()
	{
		return salary;
	}
	public void setSalary(double salary)
	{
		this.salary = salary;
	}
	public double increaseSalary(double amount)
	{
		this.salary = salary + amount;
		
		return salary;
	}
	void display()
	{
		System.out.println(id);
		System.out.println(name);
		System.out.println(salary);
	}
}
class EmployeMain 
{
	public static void main(String[] args) 
	{
		Employe e1 = new Employe(123,"david",50000);
		//System.out.println(e1.name);
		System.out.println(e1.getName());
		System.out.println(e1.getId());
		System.out.println(e1.getSalary());
		e1.increaseSalary(500);
		System.out.println(e1.getSalary());
		e1.setName("thara");
		System.out.println(e1.getName());
		
		Employe e2 = new Employe(345,"mara",50000);
		e2.increaseSalary(10000);
		e2.display();
	}
}
