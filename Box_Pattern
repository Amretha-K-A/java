class Pattern41 
{
	public static void main(String[] args) 
	{
		int num =5;
		for(int i =1 ; i <=num ; i++)
		{
			for(int j =1; j<=num; j++)
			{
				if(i==1 || i==num)
					System.out.print(1+" ");
				
				else if(j==1)
					System.out.print(i+" ");
				
				else if(j==num)
					System.out.print(num+" ");
				else
					System.out.print("  ");
			}
			System.out.println();
		}
	}
}
