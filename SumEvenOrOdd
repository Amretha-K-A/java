import java.util.*;
class SumEvenOrOdd 
{
	static Scanner sc = new Scanner(System.in);
	public static void main(String[] args) 
	{
		System.out.print("Enter the number: ");
		int n = sc.nextInt();
		int even = 0;
		int odd = 0;
		while(n>0)
		{
			int ld = n % 10;
			if(n%2==0)
				even += ld;
			else 
				odd += ld;
			n = n/10;	
		}
		System.out.println("sum of even:"+even);
		System.out.println("sum of odd:"+odd);
	}
}
