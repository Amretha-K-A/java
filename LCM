import java.util.Scanner;
class LCM
{
	static Scanner sc= new Scanner(System.in);
	public static void main(String[] args) 
	{
		System.out.print("Enter a: ");
		int a = sc.nextInt();
		System.out.print("Enter b: ");
		int b= sc.nextInt();
		int x = a;
		int y = b; 
		while(b >0)
		{
			int temp = b;
			b = a%b;
			a = temp;
		}
		int gcd = a;
		int LCM = (x * y) / gcd;
		System.out.println(LCM);
		
	}
}
