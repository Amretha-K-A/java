class Second_Max 
{
	public static void main(String[] args) 
	{
		int arr[] = {12, 35, 1, 10, 34, 1};
		int max = Integer.MIN_VALUE;
		int smax = Integer.MIN_VALUE;
		
		for(int i = 0; i<arr.length; i++)
		{
			if(arr[i] > max)
			{
				smax = max;
				max = arr[i];
			}
			else if(arr[i] >smax && arr[i] !=max)
			{
				smax = arr[i];
			}
		}
		System.out.println(smax);
	}
	
}
