import java.util.*;
class SumOfODDigit 
{
	static Scanner sc = new Scanner(System.in);
	public static void main(String[] args) 
	{
		System.out.print("Enter the number: ");
		int n = sc.nextInt();
		int sum=0;
		while(n > 0)
		{
			int ld = n % 10;
			if(n % 2!=0)
			{
				sum = sum + ld;
			}
			n = n / 10;
		}
		System.out.println(sum);
	}
}
